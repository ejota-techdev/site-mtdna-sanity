# Copie este arquivo para .env.local e preencha.
#   cp .env.local.example .env.local
#
# .env.local NAO vai para o repositorio (esta no .gitignore).

# ---------------------------------------------------------------------------
# OBRIGATORIO — sem isto a aplicacao nem sobe.
# Nao sao segredo: o Project ID aparece no HTML do site em producao.
# Peca os valores a quem ja esta no projeto, ou veja em sanity.io/manage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# OPCIONAL — deixe vazio se voce nao for mexer no formulario de contato.
#
# Este token da permissao de ESCRITA no conteudo de producao. Serve apenas
# para gravar os envios do formulario; todo o resto do site (paginas, imagens,
# Studio) funciona sem ele.
#
# Sem o token: o site roda normalmente e so o envio do formulario retorna erro.
#
# Nao tente gerar sozinho — criar token exige papel Administrator no projeto.
# Se precisar, peca a um administrador; ele gera um token nomeado para voce.
#
# Nunca prefixe com NEXT_PUBLIC_ (isso o exporia no browser) e nunca cole
# em chat, issue ou commit.
# ---------------------------------------------------------------------------
SANITY_API_WRITE_TOKEN=
